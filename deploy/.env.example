# ── Identite de l'instance ───────────────────────────────────────────
# INSTANCE_ID sert d'adresse dans la federation : court, stable, unique
# entre immeubles jumeles. Le changer apres un jumelage casse le lien.
INSTANCE_ID=pointe-est
INSTANCE_NAME=Immeuble Pointe-Est

# ── Adresse du site ──────────────────────────────────────────────────
# SITE_URL est l'URL par laquelle les usagers ET les instances jumelees
# joignent cette appliance. En reseau ferme, un nom interne ou une
# adresse VPN font l'affaire — mais la meme valeur doit etre utilisee
# partout, sinon l'authentification rejette les redirections.
SITE_URL=https://cohabitat.pointe-est.lan
SITE_HOST=cohabitat.pointe-est.lan
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=cohabitat

# ── Inscriptions et courriel ─────────────────────────────────────────
# En reseau ferme, aucun courriel ne peut sortir : MAILER_AUTOCONFIRM
# evite que les comptes restent bloques en attente de confirmation.
# Avec un relais SMTP interne, mettre false et remplir le bloc SMTP.
MAILER_AUTOCONFIRM=true
DISABLE_SIGNUP=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=admin@pointe-est.lan

# ── Centrale Modulimo ────────────────────────────────────────────────
# false = instance autonome : aucune requete ne sort, la finance reste
# locale, et la licence n'est pas verifiee. Passer a true seulement si
# la centrale est joignable (VPN) et que ce contrat existe.
CENTRAL_ENABLED=false
# CENTRAL_URL=https://central.modulimo.lan
# CENTRAL_KEY=

# ── Federation entre instances CoHabitat ─────────────────────────────
FEDERATION_ENABLED=true
# Nombre de tentatives avant de rendre l'argent d'une operation restee
# en file (VPN coupe). 20 tentatives ~ 10 h avec le recul exponentiel.
FEDERATION_OUTBOX_MAX_ATTEMPTS=20

# ── Ressources locales ───────────────────────────────────────────────
# true : librairies et polices servies depuis vendor/ (obligatoire en
# reseau ferme). Executer scripts/fetch-vendor.sh sur une machine
# connectee avant de transporter le paquet.
OFFLINE_ASSETS=true
VENDOR_FONTS=false
# Kiosque Machine Lunch, s'il est deploye sur le reseau local.
# LUNCH_KIOSK_URL=https://lunch.pointe-est.lan/

# ── Secrets ──────────────────────────────────────────────────────────
# Ne pas remplir a la main : `./cohabitat init` genere .env.secrets
# (JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY, mots de passe Postgres) et
# la cle privee de federation dans secrets/.
