# Point d'entree unique de l'appliance.
#
# L'interface, l'API de donnees, l'authentification et la federation
# vivent sous le meme nom d'hote : le front n'a donc qu'une seule URL a
# connaitre (SITE_URL), et les pairs joignent la federation par cette
# meme adresse a travers le VPN.
#
# En reseau ferme, un nom en .lan ou une adresse IP ne peut pas obtenir
# de certificat Let's Encrypt : Caddy emet alors un certificat interne.
# Installer sa racine (/data/caddy/pki) sur les postes, ou passer le
# site en http:// si le reseau est deja de confiance.

{
	# Pas de tentative ACME quand le nom n'est pas public : voir
	# ADMIN_EMAIL dans .env pour activer Let's Encrypt.
	auto_https disable_redirects
}

{$SITE_HOST:localhost} {
	encode gzip

	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy auth:9999
	}

	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy rest:3000
	}

	# Les chemins de federation sont deja prefixes cote service.
	handle /federation/* {
		reverse_proxy federation:8080
	}

	# Flux video, servis sous la meme origine pour eviter le blocage du
	# contenu mixte en https. Ne relayer QUE les cameras ouvertes aux
	# residants, jamais tout go2rtc : son API (/api/config, /api/streams)
	# donnerait toutes les cameras et sa configuration a quiconque ouvre
	# CoHabitat, et le relais ne sait pas qui est connecte. Le PTZ et les
	# cameras de la gestion restent dans l'outil camera, sur le reseau de
	# l'immeuble ou par le tunnel prive.
	#
	# Decommenter, remplacer l'adresse du serveur camera, et repeter le
	# bloc @camera_cam1 pour chaque autre camera « tenants ». La ligne
	# `uri query src ...` force le nom du flux : un second src= ajoute a
	# l'adresse est ignore.
	#
	# @camera_cam1 {
	# 	path /stream/stream.html /stream/api/ws /stream/api/frame.jpeg
	# 	query src=cam1
	# }
	# handle @camera_cam1 {
	# 	uri strip_prefix /stream
	# 	uri query src cam1
	# 	reverse_proxy 192.168.0.118:1984
	# }
	# @camera_scripts path /stream/video-stream.js /stream/video-rtc.js
	# handle @camera_scripts {
	# 	uri strip_prefix /stream
	# 	reverse_proxy 192.168.0.118:1984
	# }
	# handle /stream/* {
	# 	respond 404
	# }

	handle {
		root * /srv
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
