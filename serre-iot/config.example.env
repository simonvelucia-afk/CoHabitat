# ── Serre IoT — configuration (copiez en config.env et remplissez) ──
# config.env contient un mot de passe : chmod 600 config.env

# ── MQTT ─────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=serre/lectures
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Supabase (mêmes valeurs que le site CoHabitat) ───────────────────
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=VOTRE_ANON_KEY
# Compte « appareil » dédié (Authentication → Users). L'adresse DOIT se
# terminer par @device.local : la RLS n'autorise l'insertion de lectures
# qu'aux admins et à ces comptes capteurs.
DEVICE_EMAIL=serre-pi@device.local
DEVICE_PASSWORD=CHANGEZ_MOI

# ── Cadence d'acquisition (MQTT / capteurs) ──────────────────────────
PUBLISH_INTERVAL=5             # secondes entre deux lectures publiées en MQTT

# ── Cadence d'écriture dans Supabase (anti-gonflement de la base) ────
# Le pont n'insère une ligne serre_lectures que si une valeur a changé
# au-delà d'un seuil, OU au plus tard après DB_HEARTBEAT secondes.
# Pour tout enregistrer au rythme MQTT : DB_HEARTBEAT=5 et seuils à 0.
DB_HEARTBEAT=300               # écriture forcée même sans changement (s)
TEMP_DEADBAND=0.2             # °C : variation mini pour réécrire
LEVEL_DEADBAND=1             # %  : variation mini pour réécrire

# ── DS18B20 (températures) : identifiants ROM ────────────────────────
# Dossiers dans /sys/bus/w1/devices/ (ex: 28-01204e9f6aab).
# Laissez vide un capteur absent → la mesure sera null.
W1_AIR=
W1_RESERVOIR1=
W1_RESERVOIR2=
W1_RESERVOIR3=

# ── Niveaux : capteurs de pression via ADC I2C ADS1115 ───────────────
# Cuves IBC 1000 L (~1,15 m d'eau à plein) → capteur recommandé : NXP MPX5050DP
# (0-50 kPa ≈ 5 m, aucune saturation ; alimenté en 5 V). Sa sortie reste basse
# (~0,2-1,3 V), donc l'ADS1115 peut être alimenté en 3,3 V (n'importe quelle
# carte). Port P1 (encoche) → tube/bulleur vers la cuve ; P2 → ouvert à l'air.
ADC_ADDRESS=0x48               # adresse I2C de l'ADS1115 (0x48 par défaut)
ADC_GAIN=1                     # ±4,096 V : large marge pour 0,2-1,3 V (MPX5050)
# Canal ADS1115 (0-3) par réservoir. Laissez vide pour désactiver.
RES1_ADC_CHAN=0
RES2_ADC_CHAN=1
RES3_ADC_CHAN=2
# Calibration (MPX5050DP, IBC ~1,15 m) : ~0,2 V à vide (0 kPa), ~1,2 V à plein.
# Valeurs de départ ci-dessous — AJUSTEZ in situ (cuve vide puis pleine).
# Le % est interpolé entre les deux, borné 0-100.
RES1_V_EMPTY=0.2
RES1_V_FULL=1.2
RES2_V_EMPTY=0.2
RES2_V_FULL=1.2
RES3_V_EMPTY=0.2
RES3_V_FULL=1.2
